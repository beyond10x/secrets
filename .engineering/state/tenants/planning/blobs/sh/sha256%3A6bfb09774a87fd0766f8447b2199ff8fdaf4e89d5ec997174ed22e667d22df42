s-storage"}],"summary":"One SecretStorage port, mount routing per namespace, keychain, 1Password and the custody service as backends, a local CLI.","title":"Named, scoped secrets behind several storage backends at once"},"id":"ent-38ef0fc320f438368b9d4a102551f279","lifecycle_state":"draft","revision":1,"version":1},"order":"per_kind_only","subject":["epic","ent-38ef0fc320f438368b9d4a102551f279"]}]