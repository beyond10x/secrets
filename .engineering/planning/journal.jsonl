{"entity":"story","version":1,"id":"construct-transaction-router","revision":2,"type":"aep.entity.update/v1","from_state":"draft","to_state":"draft","changed":{"body":"## Acceptance\n\nThe service router constructs without panic. Commit and abort use valid path segments, the OpenAPI contract and client use the same paths, and a regression test exercises route registration.\n"},"args":{"changes":{"body":"## Acceptance\n\nThe service router constructs without panic. Commit and abort use valid path segments, the OpenAPI contract and client use the same paths, and a regression test exercises route registration.\n"},"command":"update-entity","target":"01MEM0000000000000007"},"payload":{"actor":"human:timo","at":1788263886231,"causation":"cmd-protocol-artifact-body-story-construct-transaction-router-1788263886231","change":{"change":"body_replaced"},"correlation":"protocol-artifact-body","event_id":"story:construct-transaction-router@2#0~343edeaa9ae067d4","executor":null,"recorded_at":"2026-09-01T11:58:06Z"}}
